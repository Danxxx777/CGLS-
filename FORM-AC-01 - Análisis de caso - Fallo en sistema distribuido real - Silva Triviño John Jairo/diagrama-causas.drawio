<mxfile host="app.diagrams.net"><diagram name="Árbol de fallos" id="arbol"><mxGraphModel dx="1300" dy="700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1300" pageHeight="620"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="top" value="Caída de la red de Google Cloud en seis regiones (2 jun 2019, 11:45–16:10 PDT) [1]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="18" width="420" height="64" as="geometry"/></mxCell><mxCell id="g0" value="Y" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="622" y="118" width="56" height="34" as="geometry"/></mxCell><mxCell id="A" value="Se detuvo el plano de control de red en varios clústeres independientes a la vez [1]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="180" y="183" width="320" height="64" as="geometry"/></mxCell><mxCell id="B" value="La red perdió capacidad y tardó en recuperarse [1]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="183" width="320" height="64" as="geometry"/></mxCell><mxCell id="gA" value="Y" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="312" y="283" width="56" height="34" as="geometry"/></mxCell><mxCell id="gB" value="O" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="932" y="283" width="56" height="34" as="geometry"/></mxCell><mxCell id="A0" value="DETONANTE: mantenimiento iniciado en una sola ubicación a las 11:45 PDT [1]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="25" y="340" width="150" height="120" as="geometry"/></mxCell><mxCell id="A1" value="Procesos del plano de control configurados para detenerse durante el mantenimiento [1]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="185" y="340" width="150" height="120" as="geometry"/></mxCell><mxCell id="A2" value="Varias instancias del gestor de clústeres elegibles para ese mantenimiento [1]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="345" y="340" width="150" height="120" as="geometry"/></mxCell><mxCell id="A3" value="CAUSA RAÍZ: error de software en la automatización, que detuvo clústeres de ubicaciones distintas a la vez [1]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="505" y="340" width="150" height="120" as="geometry"/></mxCell><mxCell id="B1" value="DEFENSA QUE FALLÓ: la red siguió en modo «fail static» solo unos minutos y luego se retiraron rutas BGP [1]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="725" y="340" width="150" height="120" as="geometry"/></mxCell><mxCell id="B2" value="Herramientas de depuración competían con la red congestionada [1]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="885" y="340" width="150" height="120" as="geometry"/></mxCell><mxCell id="B3" value="Se perdió la configuración y hubo que reconstruirla [1]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="340" width="150" height="120" as="geometry"/></mxCell><mxCell id="e0" style="endArr